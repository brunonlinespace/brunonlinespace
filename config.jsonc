{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {"padding": {"top": 1, "right": 1,"left": 1}},
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m~ HARDWARE ~"
    },
    {
      "type": "host",
      "key": "   Host",
    },
    {
      "type": "display",
      "key": "   Display",
    },
    {
      "type": "cpu",
      "key": "   CPU",
    },
    {
      "type": "gpu",
      "key": "   GPU",
    },
    {
      "type": "memory",
      "key": "   Memory",
    },
    {
      "type": "swap",
      "key": "   Swap",
    },
    {
      "type": "disk",
      "key": "   Disk",
    },
    {
      "type": "battery",
      "key": "   Battery",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m~ SOFTWARE ~"
    },
    {
      "type": "os",
      "key": "   OS",
    },
    {
      "type": "kernel",
      "key": "   Kernel",
    },
    {
      "type": "de",
      "key": "   DE",
    },
    {
      "type": "locale",
      "key": "   Locale",
    },
    {
      "type": "shell",
      "key": "   Shell",
    },
    {
      "type": "terminal",
      "key": "   Terminal",
    },
    {
      "type": "wm",
      "key": "   WM",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m~ STYLE ~"
    },
    {
      "type": "cursor",
      "key": "   Cursor",
    },
    {
      "type": "font",
      "key": "   Font",
    },
    {
      "type": "icons",
      "key": "   Icons",
    },
    {
      "type": "theme",
      "key": "   Theme",
    },
    {
      "type": "wmtheme",
      "key": "   WM Theme",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m~ STATUS ~"
    },
    {
      "type": "command",
      "key": "   Age",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "localip",
      "key": "   Local IP",
    },
    {
      "type": "packages",
      "key": "   Packages",
    },
    {
      "type": "uptime",
      "key": "   Uptime",
    },
    "break",
    "colors",
    "break"
  ]
}
